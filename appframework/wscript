def build(bld):
	source = [
		'AppSystemGroup.cpp',
		'../public/filesystem_init.cpp',
	]

	if bld.env.SDL: source += ['sdlmgr.cpp']

	if bld.env.DEST_OS == 'darwin' and bld.env.GL:
		source += ['glmrendererinfo_osx.mm']


	libs = []
	if bld.env.DEST_OS == 'win32':
		source += [
			'vguimatsysapp.cpp',
			'winapp.cpp'
		]
		defines = []
	else:
		source += [
			'posixapp.cpp',#		[$POSIX]
		]
		defines = ["DX_TO_GL_ABSTRACTION"]
		if bld.env.TOGLES: libs += ["togles"]
		else:              libs += ["togl"  ]

	includes = [
		'.',
		'../public',
		'../public/tier0',
		'../public/tier1'
	] + bld.env.INCLUDES_SDL3

	if bld.env.DEST_OS == 'darwin':
		libs += ['FOUNDATION', 'APPKIT', 'IOKIT']

	bld.stlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

